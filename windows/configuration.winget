# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
properties:
  resources:
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: jetbrainsToolbox
      settings:
        id: JetBrains.Toolbox
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: dockerDesktop
      settings:
        id: Docker.DockerDesktop
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: warpTerminal
      settings:
        id: Warp.Warp
        source: winget
